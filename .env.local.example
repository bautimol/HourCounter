# Supabase
# Get these values from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Canonical public origin, no trailing slash.
#
# Leave EMPTY for local dev: getOrigin() then reads the request host, which is
# what you want when that host is just localhost:3000.
#
# SET IT IN PRODUCTION. Vercel serves the same deployment on several hostnames
# (the clean alias, the team alias, the git-branch alias, and a unique URL per
# deployment). Without this, getOrigin() returns whichever one the visitor
# happened to arrive on, and two things break for anyone not on the canonical
# host: OAuth stops working, because Supabase only honours a redirectTo that
# exactly matches its allowlist and silently falls back to the Site URL
# otherwise; and generated invite links point at that alias instead of the
# real domain.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Web Push (VAPID)
#
# Generate a key pair once with:
#   npx web-push generate-vapid-keys
#
# Then paste the values below. The PUBLIC key is also exposed to the
# browser via NEXT_PUBLIC_VAPID_PUBLIC_KEY (same value, different prefix
# so client code can read it).
#
# VAPID_SUBJECT must be a mailto: URL or an https:// URL identifying you
# as the push sender. Required by the spec — anything reachable works.
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
